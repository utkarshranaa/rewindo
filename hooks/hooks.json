{
  "description": "Rewindo timeline hooks - captures prompts and creates checkpoints",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/log_prompt.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/log_prompt.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/log_stop.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/log_stop.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
